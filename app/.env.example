# Kardex Fimas - credenciales de conexion al ERP (Odoo) via XML-RPC.
# Copie este archivo como ".env" y complete con los datos reales.
# NO comparta ni suba el .env a ningun repositorio.

odoo_url=https://erp.suempresa.com
odoo_db=nombre_de_la_base
odoo_username=usuario.servicio@suempresa.com
odoo_password=clave_de_servicio

# --- Sincronizacion local del kardex (opcional) -------------------------------
# Intervalo, en segundos, entre dos ciclos de sincronizacion con Odoo.
# El servicio descarga de forma incremental los movimientos completados
# (stock.move), sus capas de valorizacion (stock.valuation.layer) y los quants
# a una base SQLite local, y arma el reporte desde ahi.
# 0 desactiva el servicio (el reporte se arma consultando el ERP directamente).
KARDEX_SYNC_INTERVALO_SEG=60

# Ruta del espejo local (SQLite). Si se omite se usa app\inventario.db.
# KARDEX_DB=C:\Kardex\inventario.db

# Metodo de redondeo al convertir cantidades entre unidades de medida:
# HALF-UP (predeterminado), UP o DOWN.
KARDEX_REDONDEO=HALF-UP

# --- Tablero de despacho -------------------------------------------------------
# Usuarios que nunca aparecen como responsables de PICK/PACK/OUT (p.ej. el
# personal de facturacion que valida traslados y registra la autorizacion
# SRI: su validacion es un tramite administrativo, no ejecucion de bodega).
# Acepta ids o nombres exactos de usuarios de Odoo, separados por comas.
# despacho_excluir_usuarios=56,62
# despacho_excluir_usuarios=ESPINAL ZUNIGA LUIS IGNACIO,MIRABA RODRIGUEZ MARIA GARDENIA

# Pedidos SIN asignar a ningun despachador y ejecutados directamente por
# estos usuarios (ids o nombres exactos de Odoo, separados por comas): la
# referencia de inicio del pedido pasa a ser la fecha de confirmacion de la
# orden de venta, porque no hay asignacion de despachador que consultar.
# despacho_confirmacion_directa=119
# despacho_confirmacion_directa=SANCHEZ RONQUILLO JESUS ALBERTO

# Identidades duplicadas de una misma persona (una cuenta generica usada
# antes, p. ej. usuario002, y su cuenta propia actual): pares
# "id_origen:id_canonico" separados por comas. El tablero y los reportes
# muestran y agregan a ambos como el usuario canonico (nombre incluido) y
# en el filtro aparecen una sola vez.
# despacho_alias_usuarios=141:160
