# Kardex Fimas - credenciales de conexion al ERP (Odoo) via XML-RPC.
# Copie este archivo como ".env" y complete con los datos reales.
# NO comparta ni suba el .env a ningun repositorio.

odoo_url=https://erp.suempresa.com
odoo_db=nombre_de_la_base
odoo_username=usuario.servicio@suempresa.com
odoo_password=clave_de_servicio

# --- Sincronizacion local del kardex (opcional) -------------------------------
# Intervalo, en segundos, entre dos ciclos de sincronizacion con Odoo.
# El servicio descarga de forma incremental los movimientos completados
# (stock.move), sus capas de valorizacion (stock.valuation.layer) y los quants
# a una base SQLite local, y arma el reporte desde ahi.
# 0 desactiva el servicio (el reporte se arma consultando el ERP directamente).
KARDEX_SYNC_INTERVALO_SEG=60

# Ruta del espejo local (SQLite). Si se omite se usa app\inventario.db.
# KARDEX_DB=C:\Kardex\inventario.db

# Metodo de redondeo al convertir cantidades entre unidades de medida:
# HALF-UP (predeterminado), UP o DOWN.
KARDEX_REDONDEO=HALF-UP
